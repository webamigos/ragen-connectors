# The Hono listener. The MCP endpoint is always this plus 1000 — __MCP_PORT__ —
# and both have to be published wherever this runs.
PORT=__PORT__

# Set here rather than in index.ts: OTEL reads it at import time, and an ESM
# assignment in the entrypoint runs after the imports it is trying to configure.
OTEL_SERVICE_NAME=__OTEL_SERVICE_NAME__

LOG_LEVEL=info

# HubSpot OAuth
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8003/auth/callback
HUBSPOT_AUTH_DOMAIN=app.hubspot.com

# Ragen Vault (centralized token storage)
RAGEN_TOKEN_VAULT_SERVICE_SECRET=
RAGEN_TOKEN_VAULT_URL=http://localhost:3000

# Server
OTEL_SERVICE_NAME=ragen-mcp-hubspot
PORT=8003
LOG_LEVEL=info

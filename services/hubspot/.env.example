# HubSpot OAuth
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8002/auth/callback
HUBSPOT_AUTH_DOMAIN=app.hubspot.com

# Ragen Vault (centralized token storage)
RAGEN_TOKEN_VAULT_URL=http://localhost:3000
RAGEN_TOKEN_VAULT_SERVICE_SECRET=
RAGEN_TOKEN_VAULT_SERVICE_NAME=ragen-mcp-hubspot

# Server
PORT=8002
LOG_LEVEL=info

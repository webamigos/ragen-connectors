{
  "name": "@ragen-mcp/google",
  "version": "0.1.0",
  "description": "Multi-tenant MCP server for Google (Calendar, Drive, Analytics, Ads)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "start": "node --env-file=.env.local dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@ragen-mcp/core": "*",
    "fastmcp": "^3.34.0",
    "hono": "^4.12.8",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}

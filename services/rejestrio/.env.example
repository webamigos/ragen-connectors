# ─────────────────────────────────────────────────────────────────────────────
# rejestrio MCP service — environment template
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values. The service refuses to start if any
# required variable is missing or malformed.

# Postgres connection used for the cache + audit + budget tables.
# Same database the rest of ragen-mcp uses; rejestrio owns the
# `rejestrio_*` schema/tables.
DATABASE_URL=postgresql://postgres:pass123@localhost:5432/ragen_mcp

# Rejestr.io API key. Send VERBATIM in Authorization (no "Bearer " prefix).
# Get one from https://rejestr.io/account/api.
REJESTRIO_API_KEY=replace-me

# Upstream API. Leave the default unless you're pointing at a staging endpoint.
REJESTRIO_BASE_URL=https://rejestr.io/api/v2

# Account plan tier — controls which endpoints the client will attempt.
#   base    = KRS lookups + basic profiles
#   premium = base + financial statements
#   biznes  = premium + bulk endpoints
REJESTRIO_PLAN_TIER=base

# Hard daily PLN spend cap across all customer IDs. The budget-guard
# refuses paid calls once exceeded; cache reads still work.
REJESTRIO_DEFAULT_DAILY_BUDGET_PLN=20

# Kill switch — set to "true" to force cache-only mode (incident response).
REJESTRIO_DISABLE_PAID_CALLS=false

# Hono HTTP port. The MCP httpStream listens on PORT + 1000 (so 9004 here).
PORT=8004

# ─────────────────────────────────────────────────────────────────────────────
# Server-to-server: ragen-app's leads enrichment pipeline (POST /enrich/*)
# ─────────────────────────────────────────────────────────────────────────────
# Shared secret used to HMAC-sign requests from ragen-app and ragen-worker.
# Must match `REJESTRIO_ENRICH_SECRET` in both of those services.
# Must be at least 32 characters. Generate with:
#   openssl rand -hex 32
#
# Leave UNSET to disable the /enrich/* routes entirely (they will 404).
# Unrelated to REJESTRIO_API_KEY and to MCP transport.
ENRICH_API_SECRET=
